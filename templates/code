<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script> // Replace with the actual restaurant ID from your template or a global variable

    function renderChart(chartData) {
        const chartLabels = chartData.map(item => item.date);
        const orderCounts = chartData.map(item => item.orders);
        const salesAmounts = chartData.map(item => item.sales);
        
        // Calculate totals from the received data
        const totalOrders = orderCounts.reduce((sum, current) => sum + current, 0);
        const totalSales = salesAmounts.reduce((sum, current) => sum + current, 0);

        // Update the totals in the HTML
        document.getElementById('total-orders').textContent = totalOrders;
        document.getElementById('total-sales').textContent = totalSales.toFixed(2); // Use toFixed for currency

        new Chart(document.getElementById("salesOrdersChart"), {
            data: {
                labels: chartLabels,
                datasets: [
                    {
                        type: 'line',
                        label: 'Orders',
                        data: orderCounts,
                        borderColor: 'blue',
                        borderWidth: 2,
                        yAxisID: 'y'
                    },
                    {
                        type: 'line',
                        label: 'Sales (₹)',
                        data: salesAmounts,
                        borderColor: 'green',
                        borderWidth: 2,
                        yAxisID: 'y1'
                    },
                    {
                        type: 'bar',
                        label: 'Total Sales (Bar)',
                        data: salesAmounts,
                        backgroundColor: 'rgba(255, 99, 132, 0.5)',
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                interaction: { mode: 'index', intersect: false },
                stacked: false,
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: { display: true, text: 'Orders' }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        title: { display: true, text: 'Sales (₹)' },
                        grid: { drawOnChartArea: false }
                    }
                }
            }
        });
    }

    // Fetch data from the API endpoint
    fetch('/api/chart_data')
        .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(data => {
            renderChart(data);
        })
        .catch(error => {
            console.error('Error fetching data:', error);
            // Optionally, display an error message on the page
        });
</script>

