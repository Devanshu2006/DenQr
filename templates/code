  <button onclick="payCash()">Pay with Cash</button>
  <button onclick="payUPI()">Pay with UPI</button>
</div>

<div id="upi-section" style="display:none; margin-top:20px;">
  <p>After payment, enter Transaction ID:</p>
  <input type="text" id="txnId" placeholder="Enter UPI Transaction ID" />
  <button onclick="confirmOrder()">Confirm Order</button>
</div>

<script>
async function payUPI() {
  const orderData = {
    restaurant_id: 1,  // dynamically set from QR/session
    total_amount: 550  // dynamically set from cart
  };

  const response = await fetch("/checkout", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(orderData)
  });
  const result = await response.json();

  if (result.deeplink) {
    // open UPI apps
    window.location.href = result.deeplink;
    // show txn input
    document.getElementById("upi-section").style.display = "block";
  } else {
    alert("UPI not available");
  }
}

function payCash() {
  alert("Please pay cash to waiter!");
  // here you can directly confirm order as Cash order
}

async function confirmOrder() {
  const txnId = document.getElementById("txnId").value;
  if (!txnId) {
    alert("Please enter transaction ID");
    return;
  }

  // send txn id + order to backend
  const response = await fetch("/confirm_order", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ txn_id: txnId })
  });

  const result = await response.json();
  if (result.success) {
    alert("Order placed successfully!");
    // redirect to thank-you page or order status page
  } else {
    alert("Error confirming order");
  }
}
</script>

