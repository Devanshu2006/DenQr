{% extends "main_dashboard.html" %}
{% block content %}
<div class="p-4 sm:p-6 md:p-8 bg-[#f7f3e9] min-h-screen">
    <div class="max-w-7xl mx-auto rounded-xl shadow-lg bg-white p-6 sm:p-8">
<section class="Analatics_Section">
    <div class="card">
        <h3>📊 Last 7 Days Performance</h3>
        
        <div class="hidden sm:block">
            <canvas id="salesOrdersChart"></canvas>
        </div>

        <div class="sm:hidden">
            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                {% for day_data in chart_data %}
                    <div class="flex justify-between items-center p-4 border-b border-[#e0d9cc] last:border-b-0">
                        <span class="text-base font-semibold text-[#3d3d3d]">{{ day_data.date }}</span>
                        <div class="flex flex-col items-end text-sm">
                            <span class="font-bold text-[#c98835]">{{ day_data.orders }} Orders</span>
                            <span class="text-xs text-gray-500">₹{{ day_data.sales }}</span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <p>Total Orders: {{ total_orders }} | Total Sales: ₹{{ total_sales }}</p>
    </div>
</section>

        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6 my-8">
            <div class="rounded-xl shadow-md bg-white p-6 transition-transform duration-200 hover:scale-[1.01]">
                <h3 class="text-xl font-bold text-[#3d3d3d] mb-4 pb-2 border-b-2 border-[#e0d9cc]">📦 Orders</h3>
                <div class="flex flex-col gap-2 text-[#6d6d6d]">
                    {% for order in orders_week %}
                    <div class="flex justify-between items-center py-2 border-b border-dashed border-[#e0d9cc] last:border-b-0">
                        <span class="font-semibold">{{ order[0] }}</span>
                        <span class="font-bold text-[#c98835]">{{ order[1] }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="rounded-xl shadow-md bg-white p-6 transition-transform duration-200 hover:scale-[1.01]">
                <h3 class="text-xl font-bold text-[#3d3d3d] mb-4 pb-2 border-b-2 border-[#e0d9cc]">💰 Revenue</h3>
                <div class="flex flex-col gap-2 text-[#6d6d6d]">
                    {% for mon in money %}
                    <div class="flex justify-between items-center py-2 border-b border-dashed border-[#e0d9cc] last:border-b-0">
                        <span class="font-semibold">{{ mon[0] }}</span>
                        <span class="font-bold text-[#27ae60]">₹ {{ mon[1] }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>
        
        <div class="section-header flex items-center justify-start my-4">
            <h2 class="text-2xl font-bold text-[#4a4a4a] mr-2 pb-1 border-b-2 border-[#c98835]">Menu</h2>
            <i class="fa-solid fa-pen-to-square text-[#c98835] cursor-pointer transition-colors hover:text-[#a86c2d]" 
               onclick="toggleForm('menuForm')"></i>
        </div>
        <div class="overflow-x-auto rounded-lg shadow-md mb-8">
            <table class="w-full text-center table-fixed bg-white">
                <thead class="bg-[#f0ebe2] text-[#c98835]">
                    <tr>
                        <th class="p-4 text-sm uppercase tracking-wide">Id</th>
                        <th class="p-4 text-sm uppercase tracking-wide">Name</th>
                        <th class="p-4 text-sm uppercase tracking-wide">Price</th>
                        <th class="p-4 text-sm uppercase tracking-wide">Category</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in menu %}
                    <tr class="hover:bg-[#f7f3e9] text-[#4a4a4a] transition-colors duration-200">
                        <td class="Id p-3 font-bold">{{ item[0] }}</td>
                        <td class="Name p-3">{{ item[3] }}</td>
                        <td class="price p-3">{{ item[4] }}</td>
                        <td class="Category p-3">{{ item[5] }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div id="menuForm" class="hidden-form hidden p-4 sm:p-6 bg-white rounded-lg shadow-md border border-[#e0d9cc] mb-8">
            <h2 class="text-xl font-bold mb-4 text-[#3d3d3d]">Edit Menu Items</h2>
            <form class="delete_menu" method="POST" action="/delete_menu">
                <label class="block mb-2 font-bold text-[#6d6d6d]">Name:</label>
                <input type="text" name="name" required class="w-full p-2 mb-4 rounded-md border border-[#e0d9cc] focus:outline-none focus:border-[#c98835] focus:ring-2 focus:ring-[#c98835]/30">

                <label class="block mb-2 font-bold text-[#6d6d6d]">Price:</label>
                <input type="number" name="price" required class="w-full p-2 mb-4 rounded-md border border-[#e0d9cc] focus:outline-none focus:border-[#c98835] focus:ring-2 focus:ring-[#c98835]/30"> 

                <button type="submit" class="btn-submit w-full sm:w-auto px-6 py-3 rounded-lg font-bold bg-[#c98835] text-white transition-colors hover:bg-[#a86c2d]">
                    Remove
                </button>
            </form>
        </div>

        <div class="section-header flex items-center justify-start my-4">
            <h2 class="text-2xl font-bold text-[#4a4a4a] mr-2 pb-1 border-b-2 border-[#c98835]">Team</h2>
            <i class="fa-solid fa-pen-to-square text-[#c98835] cursor-pointer transition-colors hover:text-[#a86c2d]" 
               onclick="toggleForm('teamForm')"></i>
        </div>
        <div class="overflow-x-auto rounded-lg shadow-md mb-8">
            <table class="w-full text-center table-fixed bg-white">
                <thead class="bg-[#f0ebe2] text-[#c98835]">
                    <tr>
                        <th class="p-4 text-sm uppercase tracking-wide">Id</th>
                        <th class="p-4 text-sm uppercase tracking-wide">Name</th>
                        <th class="p-4 text-sm uppercase tracking-wide">Role</th>
                        <th class="p-4 text-sm uppercase tracking-wide">Phone</th>
                    </tr>
                </thead>
                <tbody>
                    {% for member in team %}
                    <tr class="hover:bg-[#f7f3e9] text-[#4a4a4a] transition-colors duration-200">
                        <td class="Id p-3 font-bold">{{ member[0] }}</td>
                        <td class="Name p-3">{{ member[2] }}</td>
                        <td class="Role p-3">{{ member[3] }}</td>
                        <td class="Phone p-3">{{ member[4] }}</td>
                    </tr>
