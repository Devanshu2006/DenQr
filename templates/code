<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>UPI Checkout</title>
</head>
<body style="background:#300; color:white; font-family:sans-serif; text-align:center; padding:30px;">

  <button onclick="payUPI(1)">Pay via UPI</button>

  <div id="upi-section" style="display:none; margin-top:20px;">
    <p id="upi-msg"></p>
    <div id="upi-qr"></div>
    <p id="upi-amount"></p>
    <br>
    <label>After payment, enter Transaction ID:</label><br>
    <input type="text" placeholder="Enter UPI Transaction ID">
    <button>Confirm & Place Order</button>
  </div>

  <!-- QRCode library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>

  <script>
    // Sample cart
    // let cart = [];

    async function payUPI(adminId) {
      if (!cart || cart.length === 0) return alert("Cart is empty!");

      let totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

      try {
        // Call backend to get deeplink
        const response = await fetch("/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ admin_id: adminId, total_amount: totalPrice })
        });

        const result = await response.json();

        if (!result.deeplink) {
          return alert("❌ " + (result.error || "UPI not available"));
        }

        const deeplink = result.deeplink;

        const isMobile = /Android|iPhone|iPad/i.test(navigator.userAgent);

        if (isMobile) {
          // Mobile → open UPI app
          window.location.href = deeplink;
        } else {
          // Desktop → show QR code
          document.getElementById("upi-section").style.display = "block";
          document.getElementById("upi-msg").innerText = "📱 Scan this QR to Pay via UPI:";
          document.getElementById("upi-amount").innerText = "Amount: ₹" + totalPrice;

          // Generate QR
          let qr = qrcode(0, "L");
          qr.addData(deeplink);
          qr.make();
          document.getElementById("upi-qr").innerHTML = qr.createImgTag(6);
        }
      } catch (err) {
        alert("⚠️ Error: " + err.message);
      }
    }
  </script>

</body>
</html>

